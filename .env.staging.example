# Staging App
NEXT_PUBLIC_APP_NAME="Clinical Ethereality Test"
NEXT_PUBLIC_APP_URL="https://test-app.bccgroup-thailand.com"
NODE_ENV="production"
CE_DEPLOYMENT_ENVIRONMENT="test"

# Staging Database
# Use a dedicated staging database. Never point staging at production.
DATABASE_URL="mysql://USER:PASSWORD@STAGING_HOST:3306/clinical_ethereality_staging"

# Authentication
JWT_SECRET="replace-with-a-staging-secret-at-least-32-characters"
JWT_ISSUER="clinical-ethereality-test"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"
ENABLE_DEV_AUTH_BYPASS="false"

# LINE LIFF, staging channel
NEXT_PUBLIC_LINE_LIFF_ID="staging-liff-id"
LINE_CHANNEL_ID="staging-line-channel-id"
LINE_CHANNEL_SECRET="staging-line-channel-secret"
LINE_LOGIN_CALLBACK_URL="https://test-app.bccgroup-thailand.com/api/auth/line/callback"

# Set these confirmations to true only after the owner verifies that the LINE
# channel/LIFF and Zoom apps are dedicated to Test and are not reused by Production.
ZOOM_TEST_LINE_CREDENTIALS_CONFIRMED="false"
ZOOM_TEST_ZOOM_CREDENTIALS_CONFIRMED="false"

# Email, optional for staging
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Clinical Ethereality Staging <no-reply-staging@example.com>"

# SMS OTP (use a separate staging app and credentials)
SMS_OTP_PROVIDER="" # thaibulksms
SMS_OTP_API_KEY=""
SMS_OTP_API_SECRET=""
SMS_OTP_REQUEST_TIMEOUT_MS="10000"

# Video Consultations, staging/test app
ZOOM_MEETING_SDK_CLIENT_ID=""
ZOOM_MEETING_SDK_CLIENT_SECRET=""
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_HOST_USER_ID=""
ZOOM_WEBHOOK_SECRET=""
ZOOM_TEST_WEBHOOK_URL="https://test-app.bccgroup-thailand.com/api/webhooks/zoom"

# Test-only Zoom database/account/fixture guards. Store only SHA-256 digests,
# never raw database identities or user IDs. The database digest is required by
# the read-only pre-migration guard before db:migrate:deploy. See
# ZOOM_TEST_ENVIRONMENT.md for the controlled command order and input formats.
ZOOM_TEST_DATABASE_IDENTITY_SHA256=""
ZOOM_TEST_CUSTOMER_USER_ID_SHA256=""
ZOOM_TEST_DOCTOR_USER_ID_SHA256=""

# Payments, staging/test credentials only
THAI_QR_PROMPTPAY_ID=""
SLIP_VERIFICATION_PROVIDER=""
SLIP_VERIFICATION_API_URL=""
SLIP_VERIFICATION_API_KEY=""
SLIPOK_BRANCH_ID=""
SLIP_VERIFICATION_EXPECTED_RECEIVER_NAME=""
PAYMENT_WEBHOOK_SECRET=""

# Cloudinary, staging folder/account if selected
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Object Storage, staging bucket only
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Security And Compliance Feature Flags
AUDIT_LOG_RETENTION_DAYS="2555"
ENABLE_PATIENT_PORTAL="false"
ENABLE_ONLINE_BOOKING="false"
ENABLE_PAYMENTS="false"
ENABLE_AI_FEATURES="false"
ENABLE_COMMUNITY="false"
ENABLE_VIDEO_CONSULTATIONS="true"
ENABLE_PRESCRIPTIONS="false"
