# App
NEXT_PUBLIC_APP_NAME="Clinical Ethereality"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DATABASE"

# Authentication
JWT_SECRET="replace-with-a-secure-random-secret"
JWT_ISSUER="clinical-ethereality"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"
ENABLE_DEV_AUTH_BYPASS="false"

# LINE LIFF
NEXT_PUBLIC_LINE_LIFF_ID=""
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_LOGIN_CALLBACK_URL="http://localhost:3000/api/auth/line/callback"

# Email
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_FROM="Clinical Ethereality <no-reply@example.com>"

# SMS OTP (server-only; never expose these values to the browser)
SMS_OTP_PROVIDER="" # thaibulksms
SMS_OTP_API_KEY=""
SMS_OTP_API_SECRET=""
SMS_OTP_REQUEST_TIMEOUT_MS="10000"

# Video Consultations
ZOOM_MEETING_SDK_CLIENT_ID=""
ZOOM_MEETING_SDK_CLIENT_SECRET=""
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
# Zoom account user ID (or email) of the licensed host used to create/start clinical meetings.
ZOOM_HOST_USER_ID=""
ZOOM_WEBHOOK_SECRET=""

# Payments
THAI_QR_PROMPTPAY_ID=""
SLIP_VERIFICATION_PROVIDER="" # slipok or easyslip
SLIP_VERIFICATION_API_URL=""
SLIP_VERIFICATION_API_KEY=""
SLIPOK_BRANCH_ID=""
# EasySlip fallback only. SlipOK validates its registered Branch receiver via `log=true` / error 1014.
SLIP_VERIFICATION_EXPECTED_RECEIVER_NAME=""
# SlipOK only. Keep this server-side; timeout/network/quota responses fail closed.
SLIPOK_REQUEST_TIMEOUT_MS="10000"
# EasySlip v2 only. Keep this server-side; timeouts remain pending/manual review.
EASYSLIP_REQUEST_TIMEOUT_MS="10000"
PAYMENT_WEBHOOK_SECRET=""
# Server-only secret for the scheduled Store reservation cleanup endpoint.
STORE_RESERVATION_CLEANUP_SECRET=""
# Optional runner settings. Keep the secret in the runtime environment; never
# place it in the Scheduled Task command or task output.
STORE_RESERVATION_CLEANUP_URL="https://app.bccgroup-thailand.com/api/jobs/store-reservation-cleanup"
STORE_RESERVATION_CLEANUP_ALERT_AFTER_MINUTES="15"
STORE_RESERVATION_CLEANUP_TIMEOUT_MS="30000"
# Defaults to a private directory under the operating-system temp directory.
STORE_RESERVATION_CLEANUP_STATE_DIR=""

# Cloudinary, if selected
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Object Storage
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Temporary private host storage for staff photos and license proofs.
# Production must use an absolute directory outside the deployed application root.
STAFF_UPLOAD_DIR=""

# Temporary private host storage for compressed Community post images.
# Production must use an absolute writable directory outside the deployed application root.
COMMUNITY_UPLOAD_DIR=""

# Private payment-slip storage for Store and Consultation. Production must be an
# absolute writable directory outside the deployed application/document root.
PAYMENT_UPLOAD_DIR=""

# Monitoring
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Security And Compliance
AUDIT_LOG_RETENTION_DAYS="2555"
ENABLE_PATIENT_PORTAL="false"
ENABLE_ONLINE_BOOKING="false"
ENABLE_PAYMENTS="false"
ENABLE_AI_FEATURES="false"
ENABLE_COMMUNITY="false"
ENABLE_VIDEO_CONSULTATIONS="false"
ENABLE_PRESCRIPTIONS="false"
