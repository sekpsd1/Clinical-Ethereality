{
  "name": "clinical-ethereality",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:plesk": "npm run build && node scripts/prepare-plesk-artifact.cjs",
    "build:plesk-host": "npm run build && node scripts/prepare-plesk-host-runtime.cjs",
    "preflight:plesk:non-migration": "node scripts/plesk-non-migration-preflight.cjs",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "job:store-reservation-cleanup": "node scripts/store-reservation-cleanup-runner.cjs",
    "check:store-reservation-cleanup": "node scripts/store-reservation-cleanup-runner.cjs --check-readiness",
    "uat:zoom-fixture": "node scripts/zoom-uat-fixture-runner.cjs",
    "test:e2e": "playwright test",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@sentry/nextjs": "^10.53.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@emnapi/wasi-threads": "1.2.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "@emnapi/core": "1.11.2",
    "@emnapi/runtime": "1.11.2",
    "@emnapi/wasi-threads": "1.2.2"
  }
}
